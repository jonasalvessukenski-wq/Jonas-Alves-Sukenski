# Copie para .env.local (desenvolvimento) ou cadastre na Vercel (produção).
# Nunca coloque valores reais neste arquivo: ele vai para o repositório.

# Supabase (Settings > API). A service role key só existe no servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Acesso ao portal (um único dono)
PORTAL_SENHA=
SESSAO_SEGREDO=            # texto aleatório longo: openssl rand -base64 48

# Webhook da Z-API: a URL fica https://SEU-DOMINIO/api/webhooks/zapi/<WEBHOOK_SEGREDO>
WEBHOOK_SEGREDO=           # openssl rand -hex 24
ZAPI_INSTANCIA=            # id da instância do Adriano (trava contra outra instância)

# Processador (Vercel Cron envia "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=

# Claude (análise das conversas)
ANTHROPIC_API_KEY=
CLAUDE_MODELO=claude-opus-5-5

# Transcrição de áudio (serviço compatível com /audio/transcriptions) [CONFIRMAR provedor]
TRANSCRICAO_URL=
TRANSCRICAO_CHAVE=
TRANSCRICAO_MODELO=whisper-1
